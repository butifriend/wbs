rules_version = '2';

// WBS 일정 관리 — Firestore 보안 규칙
//
// 읽기: 문서 ID 를 아는 사람이면 됩니다. 지금 쓰던 "링크를 받은 사람만" 과 같은 수준입니다.
//       목록 조회(list)는 막아 두어, 앱 설정값만 가지고 문서 ID 를 훑어볼 수 없게 합니다.
// 쓰기: 정해 둔 관리자 계정(admin@douzone.com)으로 로그인했을 때만.
//       비밀번호는 Firebase 가 보관하며 화면 코드에는 들어가지 않습니다.

service cloud.firestore {
  match /databases/{database}/documents {

    match /wbs/{docId} {
      // 문서 하나를 콕 집어 읽는 것만 허용합니다.
      allow get: if true;
      // 컬렉션을 훑는 것은 막습니다. 이게 열려 있으면 문서 ID 가 비밀이 되지 못합니다.
      allow list: if false;

      allow write: if isAdmin();
    }

    // 위에 적지 않은 경로는 전부 막습니다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// 콘솔에서 만든 이메일/비밀번호 계정은 메일 인증을 거치지 않아
// email_verified 가 거짓입니다. 그래서 그 조건은 넣지 않습니다.
// 대신 아이디를 하나로 못박아 두었습니다.
function isAdmin() {
  return request.auth != null
      && request.auth.token.email == 'admin@douzone.com';
}
