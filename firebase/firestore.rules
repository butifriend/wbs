rules_version = '2';

// WBS 일정 관리 — Firestore 보안 규칙
//
// 읽기: 문서 ID 를 아는 사람이면 됩니다. 지금 쓰던 "링크를 받은 사람만" 과 같은 수준입니다.
//       목록 조회(list)는 막아 두어, 앱 설정값만 가지고 문서 ID 를 훑어볼 수 없게 합니다.
// 쓰기: 아래 명단에 올린 구글 계정만. 예전의 공유 열쇠와 달리 관리자 PC 에서
//       꺼내 갈 수 있는 비밀이 없습니다.

service cloud.firestore {
  match /databases/{database}/documents {

    match /wbs/{docId} {
      // 문서 하나를 콕 집어 읽는 것만 허용합니다.
      allow get: if true;
      // 컬렉션을 훑는 것은 막습니다. 이게 열려 있으면 문서 ID 가 비밀이 되지 못합니다.
      allow list: if false;

      allow write: if isAdmin();
    }

    // 위에 적지 않은 경로는 전부 막습니다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isAdmin() {
  return request.auth != null
      && request.auth.token.email_verified == true
      && request.auth.token.email in [
           // ↓↓↓ 편집을 허용할 구글 계정을 여기에 적으세요 (따옴표 포함, 쉼표로 구분)
           'admin@example.com'
           // , 'another@example.com'
         ];
}

// 회사 도메인 전체에 편집을 열고 싶다면 위 isAdmin() 을 아래로 바꾸세요.
